DATABASE_URL=postgresql+psycopg://edital:edital@localhost:5432/edital_match

# demo (só os exemplos, sem chave) | anthropic | openai (OpenAI, Groq ou compatível)
LLM_PROVIDER=demo
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Para Groq: LLM_PROVIDER=openai, LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=

# hashing (sem modelo) | fastembed (local, multilíngue) | openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=

# Plano gratuito do Groq (8000 tokens/min): use 12000
EDITAL_MAX_CHARS=40000
